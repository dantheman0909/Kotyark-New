modules = ["nodejs-22"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install --no-audit --no-fund && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "gce"
run = ["sh", "-c", "npm run migrate || echo 'migrate failed; starting anyway'; NODE_OPTIONS=--max-old-space-size=512 npm run start"]
build = ["sh", "-c", "npm ci --no-audit --no-fund && npm run build"]
ignorePorts = false

[objectStorage]
defaultBucketID = "replit-objstore-0e4fb7e7-4b1a-4c62-b022-73b703d6d7cc"
